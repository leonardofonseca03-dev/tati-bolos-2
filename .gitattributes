# Auto-detect text files and normalize
* text=auto

# Force LF for common web files to avoid CRLF issues across OS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Tools scripts
tools/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
